<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script type="text/javascript">
    (function() {
        emailjs.init("YOUR_PUBLIC_KEY"); // আপনার ইমেইল জেএস পাবলিক কি এখানে বসান
    })();

    document.getElementById('admissionForm').addEventListener('submit', function(event) {
        event.preventDefault();

        const btn = event.target.querySelector('button');
        btn.innerHTML = 'প্রসেস হচ্ছে...';
        btn.disabled = true;

        const params = {
            student_name: document.querySelector('input[placeholder="উদাঃ আবদুর রহমান"]').value,
            student_class: document.querySelector('select.form-select').value,
            phone: document.querySelector('input[type="tel"]').value,
        };

        emailjs.send("YOUR_SERVICE_ID", "YOUR_TEMPLATE_ID", params)
            .then(function() {
                Swal.fire({
                    title: 'সফল হয়েছে!',
                    text: 'আবেদনটি ওল্ড ডেটার সাথে মার্জ করে সফলভাবে সাবমিট করা হয়েছে।',
                    icon: 'success',
                    confirmButtonColor: '#006A4E'
                });
                document.getElementById('admissionForm').reset();
                btn.innerHTML = 'আবেদন সম্পন্ন করুন';
                btn.disabled = false;
            }, function(error) {
                Swal.fire({
                    title: 'ভুল হয়েছে!',
                    text: 'দুঃখিত, কোনো একটি ইন্টারনাল সমস্যার কারণে পাঠানো যায়নি।',
                    icon: 'error'
                });
                btn.disabled = false;
            });
    });
</script>

